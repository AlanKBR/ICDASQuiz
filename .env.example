# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# Modo debug (1 = ativo, 0 = desativado — NUNCA usar 1 em produção)
FLASK_DEBUG=0

# Chave secreta para sessões Flask — troque por um valor aleatório longo em produção
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-segura-em-producao

# Standalone/local: deixe DATABASE_URL e POSTGRES_HOST vazios e use SQLite.
DB_PATH=icdas.db
DATABASE_URL=

# Servidor PostgreSQL opcional. POSTGRES_HOST ativa este modo quando
# DATABASE_URL estiver vazia.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
